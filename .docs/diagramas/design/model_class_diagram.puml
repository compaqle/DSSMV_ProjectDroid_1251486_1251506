@startuml
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
skinparam linetype ortho
left to right direction

class Planta {
  - id: String
  - nome: String
  - especie: String
  - pid: String
  - ultimaRega: long
  - diario: List<RegistoDiario>
  + setNome(nome): void
  + setUltimaRega(ms): void
  + addRegisto(r): void
}

class Especie {
  - pid: String
  - nomeCientifico: String
  - apelido: String
  + getNomeFormatado(): String
}

class CuidadosEspecie {
  - minTemp: Integer
  - maxTemp: Integer
  - minSoilMoist: Integer
  - maxSoilMoist: Integer
  - minLightLux: Integer
  - maxLightLux: Integer
  - minEnvHumid: Integer
  - maxEnvHumid: Integer
  - categoria: String
  - origem: String
  - imagemUrl: String
}

class Aviso {
  - nomePlanta: String
  - tipo: TipoAviso
  - mensagem: String
  - dataHora: Date
  + verificarTemperatura(p, c, m): List<Aviso>
  + verificarHumidadeSolo(p, c, m): Aviso
  + obterProximaRega(p, c, m): Aviso
  + formatarData(): String
}

class MedicaoLuz {
  - maiorLux: int
  + avaliar(minLux, maxLux): Resultado
}

class Meteorologia {
  - temperatura: double
  - humidadeSolo: double
  - dataHora: Date
}

class MeteorologiaContainer {
  - {static} instancia: MeteorologiaContainer
  - previsaoHoraria: List<Meteorologia>
  + {static} getInstance(): MeteorologiaContainer
  + obterTemperaturaMinimaPrevista(): Meteorologia
  + obterTemperaturaMaximaPrevista(): Meteorologia
  + obterHumidadeSoloMaximaPrevista(): Meteorologia
  + obterPrimeiroAbaixoHumidadeMinima(min, aPartirDe): Meteorologia
}

class RegistoDiario {
  - texto: String
  - dataHora: Date
  - fotoBase64: String
}

Planta "1" --> "1" Especie
Planta "1" --> "0..*" RegistoDiario
Especie "1" --> "1" CuidadosEspecie
MeteorologiaContainer "1" --> "*" Meteorologia
Aviso ..> Planta
Aviso ..> CuidadosEspecie
Aviso ..> MeteorologiaContainer
MedicaoLuz ..> CuidadosEspecie
@enduml
