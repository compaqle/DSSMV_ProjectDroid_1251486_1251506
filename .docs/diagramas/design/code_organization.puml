@startuml
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle folder
hide circle

package "com.dssmv.plantkeep" {
    
    ' Classe principal na raiz do pacote
    [MainActivity]

    ' Fileira Superior de Pacotes
    package "ui" as ui
    package "service" as service
    package "model" as model


    ' Fileira Inferior de Pacotes
    package "helper" as helper
    package "dto" as dto
    package "handler" as handler

    ' Dependência a partir de MainActivity
    MainActivity .up.> ui

    ' Dependências Horizontais (Fileira Superior)
    ui .right.> service
    service .right.> model


    ' Dependências Verticais e Diagonais (Entre Fileiras)
    ui .down.> helper

    service .down.> helper
    service .down.> dto
    service .down.> handler

    handler .up.> model
}
@enduml
