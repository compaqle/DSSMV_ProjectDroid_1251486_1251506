@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70
skinparam componentStyle uml1
left to right direction

interface "HTTP JSON externo" as ExtHTTP

rectangle "PlantKeep (Android)" {
    component "UI (Activities)" as UI
    component "Services" as Services
    component "Model" as Model
    component "Helper" as Helper
    component "DTO + Mapper" as DTO
    component "Handler (Json Network)" as Handler

    UI -(0- Services
    UI -(0- Model
    Services -(0- Model
    Services -(0- Helper
    Services -(0- Handler
    Services -(0- DTO
    Handler -(0- DTO
}

Handler -(0- ExtHTTP

@enduml
