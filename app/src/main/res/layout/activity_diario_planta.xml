<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="24dp">

    <TextView
            android:id="@+id/txt_titulo_diario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diário da Planta"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center_horizontal" />

    <EditText
            android:id="@+id/edt_registo_diario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Escreve aqui o teu registo"
            android:inputType="textMultiLine"
            android:minLines="2" />

    <Button
            android:id="@+id/btn_adicionar_registo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Adicionar ao Diário" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Histórico de Registos"
            android:textSize="18sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/txt_estado_diario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="A carregar diário..."
            android:textSize="15sp"
            android:textColor="#666666" />

    <ListView
            android:id="@+id/lv_diario"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

    <Button
            android:id="@+id/btn_voltar_diario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltar" />

</LinearLayout>