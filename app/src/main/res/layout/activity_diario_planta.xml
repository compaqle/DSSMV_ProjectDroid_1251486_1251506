<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="24dp">

    <TextView
            android:id="@+id/txt_titulo_diario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diário da Planta"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center_horizontal" />

    <EditText
            android:id="@+id/edt_registo_diario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Escreve aqui o teu registo"
            android:inputType="textMultiLine"
            android:minLines="2" />

    <ImageView
            android:id="@+id/img_preview_diario"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            android:contentDescription="Pré-visualização da fotografia"
            android:visibility="gone" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

        <Button
                android:id="@+id/btn_tirar_foto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Tirar Foto" />

        <Button
                android:id="@+id/btn_adicionar_registo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Guardar Registo" />
    </LinearLayout>

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Histórico de Registos"
            android:textSize="18sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/txt_estado_diario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="A carregar diário..."
            android:textSize="15sp"
            android:textColor="#666666" />

    <ListView
            android:id="@+id/lv_diario"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

    <Button
            android:id="@+id/btn_voltar_diario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltar" />

</LinearLayout>